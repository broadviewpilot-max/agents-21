# Set these in Netlify: Site configuration > Environment variables. Never commit real values.
APP_PASSWORD=                 # optional for now. Empty = open to anyone with the URL. Set later to lock the site.
MAX_RUNS_PER_DAY=25
SCRAPECREATORS_API_KEY=
ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=            # optional; without it pages are read with a plain fetch
GEMINI_API_KEY=               # optional: enables the second-model Verifier (aistudio.google.com)
GEMINI_FALLBACK_MODEL=          # optional backup model if the main one is overloaded (auto-picked if empty)
GEMINI_MODEL=gemini-3.8-flash # change if the Test Gemini button lists different model names
ANTHROPIC_MODEL=claude-sonnet-5-5
SC_MAX_CREDITS_PER_RUN=15
